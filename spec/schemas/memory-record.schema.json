{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bijit-ghosh/CortexState/main/spec/schemas/memory-record.schema.json",
  "title": "CortexState Agent Memory Interchange record",
  "description": "Draft CAMI 0.1.0 portable record, excluding store-specific scope and embeddings.",
  "type": "object",
  "required": ["id", "text", "metadata", "revision", "created_at", "updated_at", "expires_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "text": {"type": "string", "minLength": 1, "maxLength": 32768},
    "metadata": {"type": "object", "additionalProperties": true},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "number", "minimum": 0},
    "updated_at": {"type": "number", "minimum": 0},
    "expires_at": {"type": ["number", "null"], "minimum": 0}
  },
  "additionalProperties": false
}
